   "source": [
    "import pandas as pd # for table\n",
    "\n",
    "def approximate_function(h, fx, a, t0=0):\n",
    "    result = 0\n",
    "\n",
    "    for i in range(4):\n",
    "        ti = t0 + i * h\n",
    "        result += a[i] * fx(ti)\n",
    "\n",
    "    return result\n",
    "\n",
    "\n",
    "fx = lambda x: np.exp(x) \n",
    "results = []\n",
    "\n",
    "for k in range(11):\n",
    "    h = 0.5 ** k\n",
    "    estimate = approximate_function(h, fx, a)\n",
    "    actual = fx(h/2)\n",
    "    error = actual - estimate\n",
    "    results.append({\n",
    "        \"h\": h,\n",
    "        \"Estimate\": estimate,\n",
    "        \"Exact\": actual,\n",
    "        \"Error\": error,\n",
    "        \"Absolute Error\": abs(error)\n",
    "    })\n",
    "df = pd.DataFrame(results)\n",
    "display(df)\n",
    "    "
   ]
  },
